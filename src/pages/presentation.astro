---
/**
 * presentation.astro
 * 22 slides con Reveal.js · Tema FinTech Guatemala 2026
 * InfoTerm: haz clic en los términos subrayados para ver definiciones técnicas
 */
// Normalizar base URL — Astro v4 puede no incluir trailing slash
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FinTech Guatemala 2026 — Presentación</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;800&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Reveal.js CDN: base + tema black (dark background base) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/reveal.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/theme/black.css" />

  <!-- KaTeX CDN para fórmulas -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" defer></script>

  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

  <!-- ─── TEMA FINTECH PERSONALIZADO ─────────────────────────── -->
  <style>
    /* ══════════════════════════════════════════════════════════════
       OVERRIDE del tema black.css — Paleta FinTech Guatemala 2026
       Las variables --r-* sobreescriben las del tema black.css
       IMPORTANTE: este <style> carga DESPUÉS del CDN → mayor especificidad
    ══════════════════════════════════════════════════════════════ */

    /* ── Variables del tema FinTech (sobreescriben black.css) ── */
    :root {
      --r-background-color:            #0A0F1E;
      --r-main-font:                   'Inter', sans-serif;
      --r-main-font-size:              36px;
      --r-main-color:                  #e2e8f0;
      --r-heading-font:                'Montserrat', sans-serif;
      --r-heading-color:               #f8fafc;
      --r-heading-font-weight:         700;
      --r-heading-text-shadow:         none;
      --r-heading-letter-spacing:      -0.02em;
      --r-heading-text-transform:      none;
      --r-heading1-size:               2.2em;
      --r-heading2-size:               1.5em;
      --r-heading3-size:               1.0em;
      --r-link-color:                  #38bdf8;
      --r-link-color-hover:            #7dd3fc;
      --r-selection-background-color:  rgba(56,189,248,0.3);
      --r-selection-color:             #fff;
      --r-controls-color:              rgba(56,189,248,0.7);
      --r-controls-back-arrow-opacity: 0.5;
      --r-progress-color:              #1A56DB;
    }

    /* ── CRÍTICO: Reset total para que Reveal.js calcule viewport correctamente ── */
    *, *::before, *::after { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background-color: #0A0F1E !important;
    }

    /* ── Forzar color de fondo en el viewport Reveal ── */
    .reveal-viewport {
      background-color: #0A0F1E !important;
    }

    /*
     * position: fixed + 100vw/100vh = inatacable.
     * El toolbar de Astro dev, el #back-home y cualquier otro elemento
     * del DOM NO afectan el tamaño que Reveal.js detecta para calcular
     * el factor de escala de los slides.
     */
    .reveal {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      background-color: #0A0F1E;
      color: #e2e8f0;
      font-family: 'Inter', sans-serif;
    }

    /* ── Secciones: layout + scroll vertical habilitado ── */
    /*
     * overflow-y: auto  → permite scroll dentro del slide si el contenido excede el alto.
     * mouseWheel: false en Reveal.js → la rueda del ratón hace scroll dentro del slide
     *             en lugar de avanzar al siguiente slide.
     * Navegación entre slides: teclas ← → o botones de control en pantalla.
     */
    .reveal .slides section {
      display: flex !important;
      flex-direction: column;
      justify-content: flex-start;
      align-items: flex-start;
      padding: 36px 52px;           /* Reducido de 48/64 → más espacio vertical */
      box-sizing: border-box;
      text-align: left;
      background-color: transparent !important;
      overflow-x: hidden;
      overflow-y: auto;             /* ← Scroll vertical habilitado */
      max-height: 100%;
      /* Scrollbar estilizado — paleta FinTech */
      scrollbar-width: thin;
      scrollbar-color: rgba(56,189,248,0.45) rgba(255,255,255,0.04);
    }
    .reveal .slides section::-webkit-scrollbar       { width: 4px; }
    .reveal .slides section::-webkit-scrollbar-track { background: rgba(255,255,255,0.04); border-radius: 2px; }
    .reveal .slides section::-webkit-scrollbar-thumb { background: rgba(56,189,248,0.45); border-radius: 2px; }
    .reveal .slides section::-webkit-scrollbar-thumb:hover { background: rgba(56,189,248,0.75); }

    .reveal .slides section.center-all {
      align-items: center;
      text-align: center;
    }

    /* ── Typography (calibrado para 1280×720 con scroll) ── */
    .reveal h1 { font-size: 2.2em; line-height: 1.1; letter-spacing: -0.03em; margin: 0 0 8px; }
    .reveal h2 { font-size: 1.45em; line-height: 1.2; margin: 0 0 6px; }
    .reveal h3 { font-size: 0.88em; color: #94a3b8; font-weight: 500; margin: 0 0 4px; }
    .reveal p  { font-size: 0.75em; line-height: 1.65; color: #cbd5e1; margin: 0 0 10px; }
    .reveal ul { list-style: none; padding: 0; margin: 0 0 8px; }
    .reveal ul li {
      font-size: 0.72em; color: #cbd5e1; padding: 4px 0 4px 18px; position: relative; line-height: 1.5;
    }
    .reveal ul li::before {
      content: '▸'; color: #38bdf8; position: absolute; left: 0; font-size: 0.9em;
    }

    /* ── Colors ── */
    .electric { color: #38bdf8; }
    .blue-txt  { color: #1A56DB; }
    .muted     { color: #94a3b8; }
    .green-txt { color: #10b981; }
    .amber-txt { color: #f59e0b; }
    .red-txt   { color: #ef4444; }
    .white-txt { color: #f8fafc; }

    /* ── Slide label (bloque) ── */
    .slide-label {
      font-family: 'Montserrat', sans-serif;
      font-size: 0.42em;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #38bdf8;
      margin-bottom: 6px;      /* reducido de 12px */
      display: block;
    }

    /* ── Decorative accent bar ── */
    .accent-bar {
      width: 40px; height: 3px;
      background: linear-gradient(90deg, #1A56DB, #38bdf8);
      border-radius: 2px;
      margin-bottom: 14px;      /* reducido de 20px */
    }

    /* ── Slide: Grid backgrounds ── */
    .bg-grid {
      background-image:
        linear-gradient(rgba(56,189,248,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(56,189,248,0.04) 1px, transparent 1px);
      background-size: 50px 50px;
    }
    .bg-navy { background: radial-gradient(ellipse at top left, #0D1B4B 0%, #0A0F1E 70%); }
    .bg-glow-blue::before {
      content: '';
      position: absolute; top: -20%; right: -10%;
      width: 50vw; height: 50vw;
      border-radius: 50%;
      background: rgba(26,86,219,0.12);
      filter: blur(80px);
      pointer-events: none;
    }

    /* ── Cards inside slides ── */
    .s-card {
      background: linear-gradient(135deg, rgba(26,86,219,0.12), rgba(56,189,248,0.05));
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 14px;
      padding: 14px 18px;     /* reducido de 20/24 */
    }
    .s-card-sm {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 10px;
      padding: 10px 14px;     /* reducido de 14/18 */
    }
    .s-card:hover, .s-card-sm:hover {
      border-color: rgba(56,189,248,0.3);
    }

    /* ── Stat big ── */
    .big-stat {
      font-family: 'Montserrat', sans-serif;
      font-weight: 800;
      font-size: 3.5em;
      color: #38bdf8;
      line-height: 1;
      letter-spacing: -0.03em;
    }
    .big-stat-sm {
      font-family: 'Montserrat', sans-serif;
      font-weight: 700;
      font-size: 2em;
      color: #38bdf8;
      line-height: 1.1;
    }
    .stat-unit { font-size: 0.45em; color: #94a3b8; font-weight: 400; }

    /* ── Formula box ── */
    .formula-box {
      background: rgba(13,27,75,0.6);
      border: 1px solid rgba(56,189,248,0.25);
      border-radius: 12px;
      padding: 16px 28px;
      font-family: 'JetBrains Mono', monospace;
      color: #38bdf8;
      font-size: 0.75em;
      text-align: center;
      margin: 12px 0;
    }

    /* ── Two-column grid ── */
    .two-col   { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; width: 100%; }
    .three-col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; width: 100%; }
    .four-col  { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px; width: 100%; }

    /* ── Table inside slides ── */
    .s-table { width: 100%; border-collapse: collapse; font-size: 0.63em; }
    .s-table th {
      background: rgba(13,27,75,0.7);
      color: #38bdf8; font-family: 'Montserrat',sans-serif;
      font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em;
      padding: 8px 12px; border-bottom: 1px solid rgba(255,255,255,0.1); text-align: left;
    }
    .s-table td {
      padding: 7px 12px; border-bottom: 1px solid rgba(255,255,255,0.05); color: #cbd5e1;
    }
    .s-table tr:hover td { background: rgba(255,255,255,0.03); }

    /* ── Badge ── */
    .s-badge {
      display: inline-flex; align-items: center;
      padding: 3px 10px; border-radius: 999px;
      font-size: 0.55em; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
    }
    .s-badge-blue   { background: rgba(56,189,248,0.15); color: #7dd3fc; border: 1px solid rgba(56,189,248,0.3); }
    .s-badge-green  { background: rgba(16,185,129,0.15); color: #6ee7b7; border: 1px solid rgba(16,185,129,0.3); }
    .s-badge-red    { background: rgba(239,68,68,0.15);  color: #fca5a5; border: 1px solid rgba(239,68,68,0.3); }
    .s-badge-amber  { background: rgba(245,158,11,0.15); color: #fcd34d; border: 1px solid rgba(245,158,11,0.3); }
    .s-badge-purple { background: rgba(168,85,247,0.15); color: #c4b5fd; border: 1px solid rgba(168,85,247,0.3); }

    /* ── Tag line for portada ── */
    .tag-line {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 16px; border-radius: 999px;
      border: 1px solid rgba(56,189,248,0.35);
      background: rgba(56,189,248,0.08);
      font-size: 0.48em; font-weight: 600;
      letter-spacing: 0.15em; text-transform: uppercase; color: #38bdf8;
      margin-bottom: 16px;
    }
    .tag-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: #38bdf8; animation: blink 1.5s ease-in-out infinite;
    }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }

    /* ── Sector legend (Slide 11) ── */
    .sector-legend { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; font-size: 0.6em; }
    .legend-item { display: flex; align-items: center; gap: 8px; }
    .legend-dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }

    /* ── Progress bar ── */
    .progress-bar {
      display: flex; align-items: center; gap: 10px; margin: 4px 0;
    }
    .progress-bar-label { font-size: 0.6em; color: #94a3b8; width: 180px; flex-shrink: 0; }
    .progress-bar-track {
      flex: 1; height: 8px; background: rgba(255,255,255,0.07); border-radius: 4px; overflow: hidden;
    }
    .progress-bar-fill {
      height: 100%; border-radius: 4px;
      background: linear-gradient(90deg, #1A56DB, #38bdf8);
      transition: width 1s ease-out;
    }
    .progress-bar-pct { font-size: 0.6em; color: #38bdf8; font-weight: 700; width: 50px; text-align: right; }

    /* ── Slide 01 portada override ── */
    #slide-portada { position: relative; overflow: hidden; }
    #slide-portada::before {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(56,189,248,0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(56,189,248,0.035) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
    }

    /* ── Slide number override ── */
    .reveal .slide-number { color: #475569; font-family: 'JetBrains Mono', monospace; font-size: 0.7em; }

    /* ── Reveal controls/progress ── */
    .reveal .controls { color: #1A56DB; }
    .reveal .progress  { background: rgba(26,86,219,0.2); }
    .reveal .progress span { background: linear-gradient(90deg, #1A56DB, #38bdf8); }

    /* ── Back to home link ── */
    #back-home {
      position: fixed; top: 14px; left: 14px; z-index: 9999;
      display: flex; align-items: center; gap: 6px;
      padding: 6px 12px; border-radius: 8px;
      background: rgba(10,15,30,0.8); border: 1px solid rgba(255,255,255,0.08);
      color: #94a3b8; font-family: 'Inter',sans-serif; font-size: 11px;
      text-decoration: none; transition: all 0.2s;
      backdrop-filter: blur(8px);
    }
    #back-home:hover { color: #38bdf8; border-color: rgba(56,189,248,0.3); }
  </style>
</head>

<body>

  <!-- Back home link -->
  <a id="back-home" href={`${base}/`}>← Inicio</a>

  <!-- ══════════════════════════════════════════════
       REVEAL.JS WRAPPER
  ═══════════════════════════════════════════════ -->
  <div class="reveal">
  <div class="slides">


    <!-- ════════════════════════════════════════════
         S01 · PORTADA
    ════════════════════════════════════════════ -->
    <section id="slide-portada" class="center-all bg-grid">
      <div style="display:flex;flex-direction:column;align-items:center;gap:16px;">
        <div class="tag-line"><span class="tag-dot"></span>Microeconomía & Administración de Empresas · 2026</div>
        <h1 style="font-size:3em;letter-spacing:-0.04em;line-height:1;text-align:center;">
          Fin<span class="electric">Tech</span><br/>
          <span style="font-size:0.55em;font-weight:300;color:#94a3b8;">Guatemala</span>
          <span class="electric" style="font-size:0.7em;"> 2026</span>
        </h1>
        <p style="text-align:center;max-width:600px;font-size:0.7em;color:#94a3b8;line-height:1.6;">
          Del banco físico al ecosistema digital — 119 empresas, 8 sectores,
          $26.8B en remesas y el marco regulatorio que lo cambia todo.
        </p>
        <div class="four-col" style="max-width:700px;margin-top:16px;">
          {[
            { v:'119', u:'empresas activas' },
            { v:'$26.8B', u:'remesas / año' },
            { v:'8', u:'sectores' },
            { v:'24.3%', u:'del PIB' },
          ].map(s => (
            <div class="s-card-sm" style="text-align:center;">
              <div class="big-stat-sm">{s.v}</div>
              <div style="font-size:0.5em;color:#94a3b8;margin-top:4px;">{s.u}</div>
            </div>
          ))}
        </div>
      </div>
    </section>


    <!-- ════════════════════════════════════════════
         S02 · AGENDA
    ════════════════════════════════════════════ -->
    <section class="bg-navy">
      <span class="slide-label">Estructura</span>
      <h2>5 Bloques Temáticos</h2>
      <div class="accent-bar"></div>
      <div class="three-col" style="margin-top:12px;">
        {[
          { num:'01', color:'#1A56DB', title:'Teoría General',     desc:'CMg→0 · Escala · Unbundling', slides:'S1–6' },
          { num:'02', color:'#0891B2', title:'Contexto Global',    desc:'UK · USA · China · Brasil · LATAM', slides:'S7–9' },
          { num:'03', color:'#6366F1', title:'Guatemala',          desc:'119 empresas · 8 sectores · Remesas', slides:'S10–16' },
        ].map(b => (
          <div class="s-card" style={`border-color:${b.color}40;`}>
            <div style={`font-family:'Montserrat',sans-serif;font-size:0.55em;font-weight:800;color:${b.color};margin-bottom:8px;`}>{b.num}</div>
            <div style="font-family:'Montserrat',sans-serif;font-weight:700;color:#f8fafc;font-size:0.7em;margin-bottom:4px;">{b.title}</div>
            <div style="font-size:0.55em;color:#94a3b8;">{b.desc}</div>
            <div class="s-badge s-badge-blue" style="margin-top:10px;">{b.slides}</div>
          </div>
        ))}
      </div>
      <div class="two-col" style="margin-top:14px;">
        {[
          { num:'04', color:'#7C3AED', title:'Marco Legal',        desc:'Decreto 7-2026 · Sandbox · JM-91-2024', slides:'S17–19' },
          { num:'05', color:'#059669', title:'Estrategia Gerencial', desc:'ROI · CX · Cuándo NO implementar', slides:'S20–22' },
        ].map(b => (
          <div class="s-card" style={`border-color:${b.color}40;`}>
            <div style={`font-family:'Montserrat',sans-serif;font-size:0.55em;font-weight:800;color:${b.color};margin-bottom:8px;`}>{b.num}</div>
            <div style="font-family:'Montserrat',sans-serif;font-weight:700;color:#f8fafc;font-size:0.7em;margin-bottom:4px;">{b.title}</div>
            <div style="font-size:0.55em;color:#94a3b8;">{b.desc}</div>
            <div class="s-badge s-badge-blue" style="margin-top:10px;">{b.slides}</div>
          </div>
        ))}
      </div>
    </section>


    <!-- ════════════════════════════════════════════
         S03 · ¿QUÉ SON LAS FINTECH?
    ════════════════════════════════════════════ -->
    <section class="bg-glow-blue">
      <span class="slide-label">Bloque 01 — Teoría General</span>
      <h2>¿Qué son las <span class="electric">FinTech</span>?</h2>
      <div class="accent-bar"></div>
      <p style="max-width:620px;margin-bottom:24px;">
        Las <strong style="color:#f8fafc;">Financial Technologies</strong> no son solo apps —
        son agentes que atacan las <strong style="color:#38bdf8;">fricciones del mercado</strong>
        (costos de búsqueda, negociación y ejecución).
      </p>
      <div class="two-col">
        <div style="display:flex;flex-direction:column;gap:10px;">
          <div class="s-card-sm">
            <div style="font-size:0.6em;font-weight:700;color:#38bdf8;font-family:'Montserrat',sans-serif;margin-bottom:4px;">
              <span class="info-term" data-it-title="Unbundling" data-it-content="La banca tradicional ofrece servicios ineficientes en combo (menú de precio fijo). Las FinTech se especializan en <strong>un solo eslabón</strong> de la cadena de valor — pagos, seguros, préstamos — para hacerlo más rápido y barato. Es como pasar de pagar por el canal de cable completo a solo suscribirse al streaming que usas." data-it-tag="economy" data-it-tag-label="Economía" data-it-tag-color="">Unbundling</span>
            </div>
            <p style="font-size:0.58em;color:#94a3b8;margin:0;">Especialización en un eslabón de la cadena de valor</p>
          </div>
          <div class="s-card-sm">
            <div style="font-size:0.6em;font-weight:700;color:#38bdf8;font-family:'Montserrat',sans-serif;margin-bottom:4px;">
              <span class="info-term" data-it-title="Desintermediación" data-it-content="Eliminación del intermediario financiero (banco) para conectar directamente al prestamista con el prestatario. Reduce el <strong>margen de intermediación</strong> y traslada el ahorro al consumidor final mediante menores comisiones. Ejemplo: Lending P2P vs. banca comercial." data-it-tag="economy" data-it-tag-label="Economía" data-it-tag-color="">Desintermediación</span>
            </div>
            <p style="font-size:0.58em;color:#94a3b8;margin:0;">Eliminar al intermediario para reducir comisiones</p>
          </div>
          <div class="s-card-sm">
            <div style="font-size:0.6em;font-weight:700;color:#38bdf8;font-family:'Montserrat',sans-serif;margin-bottom:4px;">
              <span class="info-term" data-it-title="Economías de Escala" data-it-content="A medida que el volumen de producción o usuarios aumenta, el <strong>costo promedio por unidad disminuye</strong>. En FinTech: el código ya está escrito y el servidor está encendido. Pasar de 1,000 a 1,000,000 usuarios casi no aumenta los costos operativos." data-it-tag="economy" data-it-tag-label="Economía" data-it-tag-color="">Economías de Escala</span>
            </div>
            <p style="font-size:0.58em;color:#94a3b8;margin:0;">Más usuarios = menor costo por transacción</p>
          </div>
          <div class="s-card-sm">
            <div style="font-size:0.6em;font-weight:700;color:#38bdf8;font-family:'Montserrat',sans-serif;margin-bottom:4px;">
