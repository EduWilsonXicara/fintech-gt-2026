---
    <!-- S23 · CIERRE: MUCHAS GRACIAS -->
    <section class="center-all bg-grid" id="slide-gracias">
      <div style="display:flex;flex-direction:column;align-items:center;gap:20px;width:100%;">

        <!-- Ícono decorativo -->
        <div style="font-size:2.8em;line-height:1;">🙏</div>

        <!-- Título principal -->
        <h1 style="font-size:2.4em;letter-spacing:-0.04em;line-height:1.1;text-align:center;margin:0;">
          Muchas gracias por su
          <span class="electric"> atención</span>
        </h1>

        <!-- Separador -->
        <div class="accent-bar" style="margin:4px auto;"></div>

        <!-- Pregunta -->
        <p style="font-size:1em;color:#cbd5e1;text-align:center;margin:0;font-weight:300;letter-spacing:0.01em;">
          ¿Tienen alguna <span style="color:#f8fafc;font-weight:600;">pregunta</span>?
        </p>

        <!-- Info del equipo -->
        <div class="two-col" style="max-width:480px;margin-top:10px;gap:10px;">
          <div class="s-card-sm" style="text-align:center;">
            <div style="font-size:0.48em;color:#38bdf8;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:4px;">Estudiante</div>
            <div style="font-size:0.62em;color:#f8fafc;font-weight:600;">John Doe</div>
          </div>
          <div class="s-card-sm" style="text-align:center;">
            <div style="font-size:0.48em;color:#38bdf8;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:4px;">Curso</div>
            <div style="font-size:0.62em;color:#f8fafc;font-weight:600;">Microeconomía · 2026</div>
          </div>
        </div>

        <!-- Tag inferior -->
        <div class="tag-line" style="margin-top:6px;">
          <span class="tag-dot"></span>FinTech Guatemala 2026
        </div>

      </div>
    </section>
