---
/**
 * SectorChart.astro
 * Donut chart de los 8 sectores FinTech en Guatemala (Chart.js via CDN).
 * Se puede embeber en slides de Reveal.js o en docs.
 */
interface Props {
  size?: number;
}
const { size = 320 } = Astro.props;
---

<div class="sector-chart-wrapper" style={`max-width:${size}px;margin:0 auto;`}>
  <canvas id="sector-chart" width={size} height={size}></canvas>
</div>

<script is:inline>
(function initSectorChart() {
  const canvas = document.getElementById('sector-chart');
  if (!canvas) return;
  if (!window.Chart) {
    // Retry after Chart.js loads
    setTimeout(initSectorChart, 300);
    return;
  }
  if (canvas._chartInstance) return; // Already initialized

  const ctx = canvas.getContext('2d');

  const data = {
    labels: [
      'Pagos Digitales',
      'Tech para Inst. Financieras',
      'Crédito Digital',
      'Gestión de Finanzas',
      'Criptoactivos',
      'Insurtech',
      'Neobanca',
      'Activos Fin. y Mercados',
    ],
    datasets: [{
      data: [38.5, 15.9, 15.9, 9.2, 6.7, 5.0, 3.3, 1.7],
      backgroundColor: [
        '#1A56DB',  // Pagos — blue principal
        '#0891B2',  // Tech FI — cyan dark
        '#38BDF8',  // Crédito — electric
        '#10B981',  // Gestión — green
        '#F59E0B',  // Crypto — amber
        '#8B5CF6',  // Insurtech — purple
        '#EC4899',  // Neobanca — pink
        '#6B7280',  // Mercados — gray
      ],
      borderColor: '#0A0F1E',
      borderWidth: 3,
      hoverOffset: 8,
    }],
  };

  const chart = new Chart(ctx, {
    type: 'doughnut',
    data,
    options: {
      responsive: false,
      cutout: '62%',
      plugins: {
        legend: {
          display: false,  // Leyenda personalizada abajo
        },
        tooltip: {
          backgroundColor: '#0D1B4B',
          borderColor: 'rgba(56,189,248,0.3)',
          borderWidth: 1,
          padding: 12,
          titleFont: { family: 'Montserrat', size: 13, weight: '700' },
          bodyFont:  { family: 'Inter', size: 12 },
          callbacks: {
            label: (ctx) => `  ${ctx.parsed.toFixed(1)}% del ecosistema`,
          },
        },
      },
      animation: {
        animateRotate: true,
        duration: 1200,
        easing: 'easeInOutQuart',
      },
    },
  });

  canvas._chartInstance = chart;
})();
</script>
